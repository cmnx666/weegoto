# ============================================================
#  ⚠️ 最重要的一段：被试数据绝对不能进仓库、不能上网站
# ============================================================
# EDF 文件的头部字段里直接写着被试姓名 / 性别 / 出生日期，
# results/edf_headers.csv 会把 181 个文件的姓名、性别、出生日期全列出来。
# 下面这些规则就是为了拦住它们。删任何一条之前请先想清楚。
data/
results/
results_*/
figures_*/
*.fif
*.edf
*.edf.bak
edf_headers*.csv
subject_probabilities*.csv
*subject*.csv

# 任何导出/中间产物
exports/
cache/
.npm-cache/
.mne_home/
.mplcache/

# ============================================================
#  站点构建产物
# ============================================================
node_modules/
dist/
.astro/
.pages.yml

# ============================================================
#  环境与密钥
# ============================================================
.env
.env.*
*.pem
*.key

# ============================================================
#  编辑器 / 系统
# ============================================================
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.log
