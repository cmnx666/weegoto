    "sanitize-html": "^2.18.1",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.5",
    "@types/sanitize-html": "^2.16.2",
    "typescript": "^6.0.3"
  }
}
