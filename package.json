{
  "name": "weegoto",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && node scripts/write-release.mjs",
    "preview": "astro preview",
