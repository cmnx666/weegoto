---
import { SITE, NAV } from '../consts';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
  <div class="container">
    <a class="brand" href="/" data-cursor="link">
      <span class="orb"></span>
      <span>
        {SITE.shortTitle}
        <small>EEG · DEPRESSION</small>
      </span>
    </a>
    <!-- 与主页时间线左上角共用 consts.NAV，按钮样式见 global.css 的 nav.main -->
    <nav class="main">
      {
        NAV.map((n) => (
          <a
            href={n.href}
            data-cursor="link"
            aria-current={isActive(n.href) ? 'page' : undefined}
          >
            {n.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
