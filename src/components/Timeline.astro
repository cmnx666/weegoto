    let best = EXT[0], bd = Infinity;
    for (const e of EXT) { const d = Math.abs(PTS[e].x - tx); if (d < bd) { bd = d; best = e; } }
    NODE_X.push(PTS[best].x); NODE_Y.push(PTS[best].y);
