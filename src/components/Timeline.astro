    for (const s of satEls) {
      s.vx = (s.vx + (Math.random()-0.5)*0.18*step - s.ox*0.008) * 0.95;
      s.vy = (s.vy + (Math.random()-0.5)*0.18*step - s.oy*0.008) * 0.95;
      s.ox += s.vx*step; s.oy += s.vy*step;
      const d = Math.hypot(s.ox, s.oy);
