---
/**
 * 全屏光谱时间线 —— 主页唯一内容
 *
 * 结构：
 *   ① 左上角：品牌 + 跳转其他页面的按钮
 *   ② 右上角：迷你全景图
 *   ③ 中央：电磁波谱式扫频波形（低频=简单模型 → 高频=复杂模型）
 *   ④ 波形上：8 个世代大节点（吸附在波峰/波谷）+ 19 个知识图谱小节点
 *   ⑤ 下方/上方：当前世代的简介卡（随峰谷翻面）
 *   ⑥ 点节点：全屏详情页（滚轮 fullpage 式切换）
 *
 * 知识图谱小节点默认与背景神经网络小点逐参数一致（完全隐形），
 * 只有鼠标移到大节点上才显现标签与连线。
 *
 * 样式全部以 #tl 为前缀，避免与 global.css 的 .card/.brand/.container 冲突。
 */
import { NAV, SECTION_KEYS } from '../consts';
import { getCollection } from 'astro:content';
const published = (await Promise.all(SECTION_KEYS.map(async section => (await getCollection(section, ({ data }) => !data.draft)).map(post => ({ title: post.data.title, s: post.data.title, t: section === 'progress' ? 'rep' : 'note', date: post.data.date.toISOString().slice(0, 10), href: `/${section}/${post.id}/`, generation: section === 'outlook' ? 8 : 1 }))))).flat();

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<script type="application/json" id="published-articles" set:html={JSON.stringify(published).replace(/</g, '\\u003c')} />
<div id="tl">
  <canvas id="net"></canvas>
  <div class="veil"></div>

  <!-- ① 顶栏：左上角导航 + 右上角迷你全景 -->
  <div class="topbar">
    <div class="tl-left">
      <a class="brand" href="/" data-cursor="link" aria-current={isActive('/') ? 'page' : undefined}>
        <span class="orb"></span>
        <span>weegoto<small>EEG · DEPRESSION</small></span>
      </a>
      <nav class="mainnav">
        {
          NAV.map((n) => (
            <a
              href={n.href}
              data-cursor="link"
              aria-current={isActive(n.href) ? 'page' : undefined}
            >
              {n.label}
            </a>
          ))
        }
      </nav>
    </div>
    <div class="mm-box">
      <span class="mm-cap">全景 · 光点位置</span>
      <svg id="minimap" viewBox="0 0 424 44" preserveAspectRatio="xMidYMid meet"></svg>
    </div>
  </div>

  <!-- 图例 -->
  <div class="legend">
    <div class="t">图例 · LEGEND</div>
    <div class="row"><span class="sw big"></span>模型路线（8）</div>
    <div class="row"><span class="sw rep"></span>已发布进展</div>
    <div class="row"><span class="sw note"></span>心得分享</div>
    <div class="row"><span class="sw line"></span>隶属连线</div>
    <div class="hint">悬停大节点 → 显现其知识图谱</div>
    <div class="hint2">模型路线仅作学习导航，不代表性能排名</div>
  </div>

  <!-- ③④ 主舞台 -->
  <svg id="stage" viewBox="0 0 1400 760" preserveAspectRatio="xMidYMid slice" aria-label="模型演进谱系"></svg>

  <!-- ⑤ 简介卡 -->
  <div class="card-wrap" id="cardWrap">
    <div class="card" id="card">
      <div class="accent" id="c-accent"></div>
      <div class="genrow">
        <span class="gen" id="c-gen">GEN 1</span>
        <h2 id="c-name">SVM</h2>
        <span class="cn" id="c-cn">支持向量机</span>
      </div>
      <p class="one" id="c-one"></p>
      <div class="body" id="c-body"></div>
      <div class="kgline">
        <span class="lbl">知识图谱</span>
        <span id="c-kg"></span>
      </div>
    </div>
  </div>

  <!-- 底部控制 -->
  <div class="controls">
    <div class="scrollhint"><span class="wheel"></span>滚轮 → 沿光谱前进</div>
    <div class="pageinfo">GEN <b id="pg">1</b> / 8</div>
    <div class="navbtns">
      <button class="nbtn prev" id="prev">‹ 上一页</button>
      <button class="nbtn next" id="next">下一页 ›</button>
    </div>
  </div>

  <!-- ⑥ 全屏详情 -->
  <div class="detail" id="detail" role="dialog" aria-modal="true" aria-labelledby="d-name" inert>
    <div class="d-top">
      <span class="lab">DETAIL · <b id="d-pg">GEN 1 / 8</b></span>
      <span class="nav">
        <button class="d-arrow" id="d-prev" title="上一代">‹</button>
        <button class="d-arrow" id="d-next" title="下一代">›</button>
        <button class="d-close" id="d-close" title="关闭 (Esc)">✕</button>
      </span>
    </div>
    <div class="d-view">
      <div class="d-body" id="d-body">
        <div class="d-card">
          <div class="accent" id="d-accent"></div>
          <aside class="d-rail">
            <div class="d-big" id="d-big">G1</div>
            <div class="d-band" id="d-band">δ · 低频起步</div>
            <div class="d-railtags" id="d-railtags"></div>
          </aside>
          <div class="d-content">
            <header class="d-head">
              <span class="gen" id="d-gen">GEN 1</span>
              <h2 id="d-name">SVM</h2>
              <span class="cn" id="d-cn">支持向量机</span>
            </header>
            <p class="d-one" id="d-one"></p>
            <div class="d-cols">
              <section class="d-panel gain"><h4>解决了上一代的什么</h4><p id="d-gain"></p></section>
              <section class="d-panel cost"><h4>留下了什么新问题</h4><p id="d-cost"></p></section>
            </div>
            <section class="d-panel eeg"><h4>在我们的 EEG 项目里</h4><p id="d-eeg"></p></section>
            <section class="d-kg">
              <h4>相关知识图谱 <span class="cnt" id="d-kgcnt"></span></h4>
              <ul id="d-kglist"></ul>
            </section>
          </div>
        </div>
      </div>
    </div>
    <div class="d-foot">
      <span><span class="arr">↓</span>滚动切换相邻世代</span>
      <span>ESC / ✕ 返回光谱</span>
    </div>
  </div>
</div>

<!-- Runtime is initialized by BrainIntro after the opening animation. -->

<style is:global>
  /* =====================================================================
     全部选择器以 #tl 为前缀 —— 避免与 global.css 的 .card / .brand /
     .container / .hero 等通用类名互相污染。
     ===================================================================== */
  body.tl-lock { overflow: hidden; }
  body.bare { background: #070512; }

  #tl {
    --tl-ink: #ece9f8; --tl-ink2: #a49dc6; --tl-dim: #6f689a;
    --tl-vi: #a78bfa; --tl-vi-deep: #8b5cf6; --tl-vi-line: rgba(167,139,250,.16);
    --tl-am: #fbbf24; --tl-panel: rgba(21,16,44,.6);
    position: fixed; inset: 0; overflow: hidden;
    background: #070512; color: var(--tl-ink);
    font-family: "Microsoft YaHei", "PingFang SC", system-ui, -apple-system, sans-serif;
  }
  #tl *, #tl *::before, #tl *::after { box-sizing: border-box; }
  #tl button { font-family: inherit; }
  #tl a { text-decoration: none; }

  #tl #net { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; }
  #tl .veil { position: fixed; inset: 0; z-index: 1; pointer-events: none;
    background: radial-gradient(1100px 620px at 50% 26%, rgba(7,5,18,.06), rgba(7,5,18,.6) 78%); }

  /* ---------- 顶栏：左上角导航 ---------- */
  #tl .topbar { position: fixed; top: 0; left: 0; right: 0; z-index: 20;
    display: flex; justify-content: space-between; align-items: flex-start; gap: 22px;
    padding: 14px 26px; background: linear-gradient(rgba(7,5,18,.9), transparent);
    pointer-events: none; }
  #tl .topbar > * { pointer-events: auto; }
  #tl .tl-left { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; min-width: 0; }
  #tl .brand { display: flex; align-items: center; gap: 10px; font-weight: 800;
    font-size: 16px; color: var(--tl-ink); flex: none; }
  #tl .brand .orb { width: 12px; height: 12px; border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #d6c8ff, var(--tl-vi) 60%, #5b3fb8);
    box-shadow: 0 0 14px var(--tl-vi); }
  #tl .brand small { display: block; font-size: 10px; font-weight: 500;
    color: var(--tl-dim); letter-spacing: .14em; }
  #tl .mainnav { display: flex; gap: 6px; flex-wrap: wrap; }
  #tl .mainnav a { font-size: 13.5px; color: var(--tl-ink2); padding: 7px 14px;
    border-radius: 999px; border: 1px solid var(--tl-vi-line);
    background: rgba(21,16,44,.6); backdrop-filter: blur(8px); transition: .18s; }
  #tl .mainnav a:hover { border-color: var(--tl-vi); color: var(--tl-ink); }
  #tl .mainnav a[aria-current="page"] { background: rgba(167,139,250,.14);
    color: var(--tl-vi); font-weight: 700; }

  #tl .mm-box { display: flex; align-items: center; gap: 10px; flex: none; }
  #tl .mm-cap { font-family: "Cascadia Code", Consolas, monospace; font-size: 10px;
    color: var(--tl-dim); letter-spacing: .12em; }
  #tl #minimap { height: 40px; width: min(360px, 30vw); opacity: .92; }

  /* ---------- 图例（左下角） ---------- */
  #tl .legend { position: fixed; bottom: 92px; left: 26px; z-index: 12;
    display: flex; flex-direction: column; gap: 8px;
    background: var(--tl-panel); border: 1px solid var(--tl-vi-line);
    border-radius: 14px; padding: 12px 15px; backdrop-filter: blur(10px); }
  #tl .legend .t { font-family: "Cascadia Code", Consolas, monospace; font-size: 10.5px;
    color: var(--tl-dim); letter-spacing: .14em; margin-bottom: 2px; }
  #tl .legend .row { display: flex; align-items: center; gap: 9px;
    font-size: 12.5px; color: var(--tl-ink2); }
  #tl .legend .sw { width: 11px; height: 11px; border-radius: 50%; flex: none; }
  #tl .legend .sw.big { width: 14px; height: 14px; background: #0b0718;
    border: 2.5px solid var(--tl-vi); }
  #tl .legend .sw.rep { background: var(--tl-am); box-shadow: 0 0 7px var(--tl-am); }
  #tl .legend .sw.note { background: var(--tl-vi); box-shadow: 0 0 7px var(--tl-vi); }
  #tl .legend .sw.line { width: 18px; height: 1px; border-radius: 0;
    background: repeating-linear-gradient(90deg, var(--tl-dim) 0 3px, transparent 3px 6px); }
  #tl .legend .hint { margin-top: 5px; padding-top: 9px;
    border-top: 1px dashed var(--tl-vi-line); font-size: 11.5px; color: var(--tl-am); }
  #tl .legend .hint2 { margin-top: 3px; font-size: 11.5px; color: var(--tl-vi); }

  /* ---------- 主舞台 ---------- */
  #tl #stage { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 2; }
  #tl #stage text { font-family: inherit; user-select: none; }
  #tl .sat { cursor: pointer; }
  #tl .sat text { pointer-events: none; }
  #tl .satlink { pointer-events: none; }

  /* ---------- 简介卡（随峰谷翻面） ---------- */
  #tl .card-wrap { position: fixed; left: 0; right: 0; top: 0; z-index: 10;
    transition: transform .55s cubic-bezier(.2,.85,.25,1); }
  #tl .card { width: min(880px, 93vw); margin: 0 auto; position: relative;
    background: var(--tl-panel); border: 1px solid var(--tl-vi-line);
    border-radius: 20px; padding: 20px 26px; backdrop-filter: blur(14px);
    overflow: hidden; box-shadow: 0 20px 60px rgba(60,30,150,.32); }
  #tl .card .accent { position: absolute; left: 0; top: 0; bottom: 0; width: 4px;
    transition: background .3s; }
  #tl .card .genrow { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  #tl .card .gen { font-family: "Cascadia Code", Consolas, monospace; font-size: 12px;
    font-weight: 700; letter-spacing: .1em; border: 1px solid currentColor;
    border-radius: 6px; padding: 2px 10px; }
  #tl .card h2 { font-size: 23px; font-weight: 800; letter-spacing: -.02em; margin: 0; }
  #tl .card .cn { font-size: 13.5px; color: var(--tl-dim); }
  #tl .card .one { font-size: 14.5px; color: var(--tl-ink2); font-style: italic;
    margin: 7px 0 11px; }
  #tl .card .body { font-size: 14px; line-height: 1.8; color: var(--tl-ink2); }
  #tl .card .body p { margin: 0 0 6px; }
  #tl .card .body b { color: #fff; }
  #tl .kgline { display: flex; align-items: center; gap: 10px; margin-top: 13px;
    padding-top: 12px; border-top: 1px dashed var(--tl-vi-line); flex-wrap: wrap; }
  #tl .kgline .lbl { font-family: "Cascadia Code", Consolas, monospace; font-size: 10.5px;
    color: var(--tl-dim); letter-spacing: .12em; flex: none; }
  #tl .chip { display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px;
    color: var(--tl-ink2); background: rgba(167,139,250,.06);
    border: 1px solid var(--tl-vi-line); border-radius: 999px; padding: 3px 12px;
    cursor: pointer; transition: .16s; }
  #tl .chip:hover { border-color: var(--tl-vi); color: var(--tl-ink); }
  #tl .chip i { width: 7px; height: 7px; border-radius: 50%; flex: none; }
  #tl .chip.rep i { background: var(--tl-am); box-shadow: 0 0 6px var(--tl-am); }
  #tl .chip.note i { background: var(--tl-vi); box-shadow: 0 0 6px var(--tl-vi); }
  #tl .chip.more { color: var(--tl-am); border-color: rgba(251,191,36,.28);
    background: rgba(251,191,36,.14); font-weight: 700; }
  #tl .card.zoomin { animation: tl-zoomin .5s cubic-bezier(.2,.8,.3,1); }
  @keyframes tl-zoomin {
    from { opacity: 0; transform: scale(.8) translateY(22px); }
    to   { opacity: 1; transform: none; }
  }

  /* ---------- 底部控制 ---------- */
  #tl .controls { position: fixed; left: 0; right: 0; bottom: 0; z-index: 20;
    display: flex; align-items: center; justify-content: space-between;
    padding: 15px 34px; background: linear-gradient(transparent, rgba(7,5,18,.93) 42%); }
  #tl .scrollhint { display: flex; align-items: center; gap: 10px;
    font-family: "Cascadia Code", Consolas, monospace; font-size: 12px;
    color: var(--tl-dim); letter-spacing: .08em; }
  #tl .scrollhint .wheel { width: 15px; height: 24px; border: 2px solid var(--tl-vi);
    border-radius: 8px; position: relative; }
  #tl .scrollhint .wheel::before { content: ""; position: absolute; left: 50%; top: 4px;
    width: 3px; height: 6px; background: var(--tl-am); border-radius: 2px;
    transform: translateX(-50%); animation: tl-whl 1.6s ease-in-out infinite; }
  @keyframes tl-whl { 0%,100% { top: 4px; opacity: 1; } 50% { top: 12px; opacity: .2; } }
  #tl .pageinfo { font-family: "Cascadia Code", Consolas, monospace; font-size: 13px;
    color: var(--tl-dim); letter-spacing: .12em; }
  #tl .pageinfo b { color: var(--tl-ink); font-size: 16px; }
  #tl .navbtns { display: flex; gap: 12px; }
  #tl .nbtn { display: inline-flex; align-items: center; gap: 8px; font-size: 14.5px;
    font-weight: 700; padding: 12px 26px; border-radius: 999px;
    border: 1px solid var(--tl-vi-line); color: var(--tl-ink2);
    background: rgba(21,16,44,.7); cursor: pointer; transition: .18s;
    backdrop-filter: blur(8px); }
  #tl .nbtn:hover { border-color: var(--tl-vi); color: var(--tl-ink); }
  #tl .nbtn.next { background: linear-gradient(120deg, var(--tl-vi-deep), var(--tl-vi));
    color: #120a24; border-color: transparent;
    box-shadow: 0 6px 26px rgba(139,92,246,.4); animation: tl-nb 2.2s ease-in-out infinite; }
  @keyframes tl-nb { 50% { box-shadow: 0 6px 40px rgba(139,92,246,.7); } }

  /* ---------- 全屏详情 ---------- */
  #tl .detail { position: fixed; inset: 0; z-index: 50; background: rgba(7,5,18,.965);
    backdrop-filter: blur(16px); transform: translateY(102%);
    transition: transform .55s cubic-bezier(.2,.85,.25,1);
    display: flex; flex-direction: column; }
  #tl .detail.open { transform: translateY(0); }
  #tl .d-top { display: flex; justify-content: space-between; align-items: center;
    padding: 15px 38px; border-bottom: 1px solid var(--tl-vi-line); flex: none; }
  #tl .d-top .lab { font-family: "Cascadia Code", Consolas, monospace; font-size: 12.5px;
    color: var(--tl-dim); letter-spacing: .18em; }
  #tl .d-top .lab b { color: var(--tl-am); }
  #tl .d-top .nav { display: flex; align-items: center; gap: 12px; }
  #tl .d-arrow { width: 40px; height: 40px; border-radius: 50%;
    border: 1px solid var(--tl-vi-line); background: rgba(21,16,44,.7);
    color: var(--tl-ink2); font-size: 16px; cursor: pointer; transition: .18s; }
  #tl .d-arrow:hover { border-color: var(--tl-vi); color: var(--tl-ink); }
  #tl .d-close { width: 40px; height: 40px; border-radius: 50%;
    border: 1px solid var(--tl-vi-line); background: rgba(21,16,44,.7);
    color: var(--tl-ink); font-size: 17px; cursor: pointer; transition: .18s; }
  #tl .d-close:hover { border-color: var(--tl-am); color: var(--tl-am); transform: rotate(90deg); }

  #tl .d-view { flex: 1; overflow-y: auto; overflow-x: hidden; position: relative; min-height: 0; }
  #tl .d-body { min-height: 100%; display: flex; align-items: center;
    justify-content: center; padding: 20px 24px;
    transition: .38s cubic-bezier(.2,.8,.3,1); }
  #tl .d-body.out-up { opacity: 0; transform: translateY(-40px); transition: .28s ease; }
  #tl .d-body.out-dn { opacity: 0; transform: translateY(40px);  transition: .28s ease; }
  #tl .d-body.in-up { animation: tl-inUp .4s cubic-bezier(.2,.8,.3,1); }
  #tl .d-body.in-dn { animation: tl-inDn .4s cubic-bezier(.2,.8,.3,1); }
  @keyframes tl-inUp { from { opacity: 0; transform: translateY(40px); }  to { opacity: 1; transform: none; } }
  @keyframes tl-inDn { from { opacity: 0; transform: translateY(-40px); } to { opacity: 1; transform: none; } }

  #tl .d-card { width: min(1500px, 100%); position: relative; overflow: hidden;
    background: var(--tl-panel); border: 1px solid var(--tl-vi-line); border-radius: 24px;
    box-shadow: 0 24px 70px rgba(60,30,150,.35);
    display: grid; grid-template-columns: clamp(180px, 15vw, 236px) 1fr;
    gap: clamp(22px, 2.6vw, 48px);
    padding: clamp(24px, 2.6vw, 44px) clamp(26px, 3vw, 54px); }
  #tl .d-card .accent { position: absolute; left: 0; top: 0; bottom: 0; width: 5px; }
  #tl .d-rail { display: flex; flex-direction: column; gap: clamp(14px, 1.5vw, 22px);
    border-right: 1px solid var(--tl-vi-line); padding-right: clamp(18px, 2vw, 36px); }
  #tl .d-big { font-family: "Cascadia Code", Consolas, monospace; font-weight: 800;
    line-height: .84; letter-spacing: -.05em; font-size: clamp(52px, 6.4vw, 96px); }
  #tl .d-band { font-family: "Cascadia Code", Consolas, monospace;
    font-size: clamp(10.5px, .9vw, 13px); color: var(--tl-dim); letter-spacing: .16em; }
  #tl .d-railtags { display: flex; flex-direction: column; gap: 7px; margin-top: 2px; }
  #tl .d-railtags span { font-family: "Cascadia Code", Consolas, monospace;
    font-size: clamp(11px, .85vw, 12.5px); color: var(--tl-ink2);
    background: rgba(167,139,250,.06); border: 1px solid var(--tl-vi-line);
    border-radius: 7px; padding: 5px 10px; text-align: center; }
  #tl .d-content { min-width: 0; display: flex; flex-direction: column;
    gap: clamp(14px, 1.4vw, 22px); }
  #tl .d-head { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; }
  #tl .d-head .gen { font-family: "Cascadia Code", Consolas, monospace;
    font-size: clamp(11.5px, .95vw, 13.5px); font-weight: 700; letter-spacing: .12em;
    border: 1px solid currentColor; border-radius: 7px; padding: 3px 12px; }
  #tl .d-head h2 { font-size: clamp(28px, 3.3vw, 48px); font-weight: 800;
    letter-spacing: -.025em; line-height: 1.06; margin: 0; }
  #tl .d-head .cn { font-size: clamp(13px, 1.15vw, 17px); color: var(--tl-dim); }
  #tl .d-one { font-size: clamp(15px, 1.3vw, 19.5px); color: var(--tl-ink2);
    font-style: italic; line-height: 1.6; padding-left: 14px;
    border-left: 2px solid var(--tl-vi-line); margin: 0; }
  #tl .d-cols { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(12px, 1.3vw, 20px); }
  #tl .d-panel { border-radius: 13px; padding: clamp(14px, 1.4vw, 22px) clamp(16px, 1.6vw, 26px); }
  #tl .d-panel h4 { font-size: clamp(11px, .92vw, 13px); font-weight: 800;
    letter-spacing: .1em; margin: 0 0 8px; }
  #tl .d-panel p { font-size: clamp(13.5px, 1.05vw, 16.5px); line-height: 1.8; margin: 0; }
  #tl .d-panel.gain { background: rgba(74,222,128,.075); border: 1px solid rgba(74,222,128,.24); color: #bbf7d0; }
  #tl .d-panel.gain h4 { color: #4ade80; }
  #tl .d-panel.cost { background: rgba(251,191,36,.075); border: 1px solid rgba(251,191,36,.24); color: #fde68a; }
  #tl .d-panel.cost h4 { color: var(--tl-am); }
