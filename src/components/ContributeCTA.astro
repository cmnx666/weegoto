---
// 「心得分享」栏目顶部的投稿入口 —— V2 突触风格
import { CONTRIBUTE } from '../consts';
---

<section class="contribute-cta" data-cursor="card" data-magnetic="0.1" data-tag="投稿 →">
  <div class="cta-main">
    <span class="badge">开放投稿</span>
    <h2>这个栏目，欢迎所有人来写</h2>
    <p>
      不限于项目组成员 —— 任何访客都可以在这里分享论文笔记、方法学思考、工具踩坑，
      或者你对脑电与抑郁症这个话题的任何观察。经项目组审核后发布。
    </p>
    <div class="cta-actions">
      <a class="btn primary" href={CONTRIBUTE.submitUrl} target="_blank" rel="noopener"
         data-cursor="button" data-magnetic="0.4" data-tag="去投稿 →">
        ✍️ 我要投稿
      </a>
      <a class="btn ghost" href={CONTRIBUTE.guideUrl} data-cursor="button" data-magnetic="0.4" data-tag="看指南 →">
        先看投稿指南
      </a>
    </div>
    <ul class="cta-facts">
      <li>需要 GitHub 账号（投稿走 GitHub 表单）</li>
      <li>人工审核后发布，通常 1–3 天</li>
      <li>署名可以自定义，也可以匿名</li>
      <li>内容以 CC BY 4.0 协议共享</li>
    </ul>
  </div>

  <div class="cta-note">
    <strong>⚠️ 有一条红线</strong>
    <p>
      请<strong>不要</strong>在投稿里写任何个人的医疗信息 —— 诊断、用药、就医记录、量表分数，
      以及任何可识别到具体个人的数据。一旦发布，内容会被搜索引擎收录且无法彻底撤回。
    </p>
  </div>
</section>

<style>
  .contribute-cta {
    background: linear-gradient(
      180deg,
      rgba(167, 139, 250, 0.09),
      var(--panel) 55%
    );
    border: 1px solid var(--vi-line-2);
    border-radius: var(--radius);
    padding: 26px 28px;
    margin-bottom: 30px;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: var(--shadow);
    will-change: transform;
  }

  .badge {
    display: inline-block;
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--vi);
    background: var(--vi-soft);
    border: 1px solid var(--vi-line-2);
    border-radius: 999px;
    padding: 3px 12px;
    margin-bottom: 12px;
  }

  .cta-main h2 {
    margin: 0 0 10px;
    font-size: clamp(20px, 2.8vw, 25px);
    letter-spacing: -0.015em;
    font-weight: 800;
    color: var(--ink);
  }

  .cta-main > p {
    margin: 0 0 18px;
    color: var(--ink-2);
    font-size: 15.4px;
    max-width: 680px;
  }

  .cta-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 14.6px;
    font-weight: 700;
    padding: 10px 22px;
    border-radius: 999px;
    border: 1px solid transparent;
    will-change: transform;
    transition: box-shadow 0.18s, border-color 0.18s, color 0.18s;
  }
  .btn:hover { text-decoration: none; }

  .btn.primary {
    background: linear-gradient(120deg, var(--vi-deep), var(--vi));
    color: #120a24;
    box-shadow: 0 6px 26px rgba(139, 92, 246, 0.35);
  }
  .btn.primary:hover { box-shadow: 0 10px 34px rgba(139, 92, 246, 0.55); }

  /* 跳转站内页面 —— 与主导航按钮同一套视觉语言 */
  .btn.ghost {
    background: rgba(21, 16, 44, 0.6);
    border-color: var(--vi-line);
    color: var(--ink-2);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .btn.ghost:hover { border-color: var(--vi); color: var(--ink); }

  .cta-facts {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    font-size: 13.4px;
    color: var(--dim);
  }
  .cta-facts li::before {
    content: "·";
    margin-right: 6px;
    color: var(--vi);
    font-weight: 800;
  }

  .cta-note {
    margin-top: 20px;
    padding: 14px 18px;
    border-radius: var(--radius-sm);
    background: rgba(248, 113, 113, 0.1);
    border: 1px solid rgba(248, 113, 113, 0.32);
    border-left: 4px solid #f87171;
    font-size: 14.2px;
    color: var(--ink-2);
  }
  .cta-note strong { color: #fca5a5; display: block; margin-bottom: 5px; }
  .cta-note p { margin: 0; }
  .cta-note p strong { display: inline; color: inherit; }

  @media (max-width: 640px) {
    .contribute-cta { padding: 20px; }
    .btn { width: 100%; justify-content: center; }
  }
</style>
