---
import { SITE, CONTRIBUTE } from '../consts';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div>
      © {year} {SITE.author} · 本站只发布<b>聚合统计结果</b>，不包含任何被试的原始数据或个人信息。
    </div>
    <div style="margin-top:8px">
      <a href={CONTRIBUTE.guideUrl} data-cursor="link">投稿心得</a> ·
      <a href="/rss.xml" data-cursor="link">RSS</a> ·
      <a href="/sitemap-index.xml" data-cursor="link">站点地图</a>
      {
        SITE.github && SITE.github !== 'https://github.com/' && (
          <> · <a href={SITE.github} data-cursor="link">代码仓库</a></>
        )
      }
      {SITE.email && <> · <a href={`mailto:${SITE.email}`} data-cursor="link">{SITE.email}</a></>}
    </div>
    <div style="margin-top:8px">
      数据集来源：HUSM_EEG（公开发表，使用请遵守其原始许可）
    </div>
  </div>
</footer>
