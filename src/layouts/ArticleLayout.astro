---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { renderGuestMarkdown } from '../lib/safe-markdown.mjs';
import { SECTIONS, CONTRIBUTE, type SectionKey } from '../consts';

interface Props {
  entry: CollectionEntry<SectionKey>;
  section: SectionKey;
}

const { entry, section } = Astro.props;
const { Content } = entry.data.source === 'guest' ? { Content: null } : await render(entry);
const guestHtml = entry.data.source === 'guest' ? renderGuestMarkdown(entry.body) : '';
const meta = SECTIONS[section];
const fmt = (d: Date) =>
  `${d.getFullYear()} 年 ${d.getMonth() + 1} 月 ${d.getDate()} 日`;

const isGuest = entry.data.source === 'guest';
const author = entry.data.author;
const issue = entry.data.issue;
---

<BaseLayout title={entry.data.title} description={entry.data.description} articleDate={entry.data.date} author={author}>
  <article>
    <div class="crumb">
      <a href="/" data-cursor="link">首页</a> /
      <a href={`/${section}`} data-cursor="link">{meta.label}</a>
    </div>

    <header class="article-head">
      <h1>{entry.data.title}</h1>
      <div class="meta">
        <span>{fmt(entry.data.date)}</span>
        {isGuest && <span class="guest-badge">访客投稿</span>}
        {author && <span class="byline">✍️ {author}</span>}
        {entry.data.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
    </header>

    <div class="prose">
      {isGuest ? <div set:html={guestHtml} /> : Content && <Content />}
    </div>

    {
      isGuest && (
        <aside class="guest-foot">
          <p>
            本文由访客投稿，内容代表作者个人观点，不一定代表项目组立场。
            如果你发现事实性问题，欢迎在
            <a
              href={issue ? `${CONTRIBUTE.issuesUrl}/${issue}` : CONTRIBUTE.issuesUrl}
              target="_blank"
              rel="noopener"
              data-cursor="link"
            >
              原始投稿讨论
            </a>
            中指出。
          </p>
        </aside>
      )
    }

    {
      section === 'notes' && (
        <aside class="write-cta">
          <div>
            <strong>也想写一篇？</strong>
            <p>「心得分享」栏目向所有访客开放，不限于项目组成员。</p>
          </div>
          <a
            class="write-btn"
            href={CONTRIBUTE.guideUrl}
            data-cursor="button"
            data-magnetic="0.35"
            data-tag="看指南 →"
          >
            看看怎么投稿 →
          </a>
        </aside>
      )
    }
  </article>
</BaseLayout>

<style>
  .guest-badge {
    font-size: 12px;
    font-weight: 800;
    color: var(--vi);
    background: var(--vi-soft);
    border: 1px solid var(--vi-line-2);
    border-radius: 999px;
    padding: 2px 11px;
  }

  .byline { color: var(--ink-2); font-weight: 600; }

  .guest-foot {
    margin-top: 44px;
    padding: 16px 20px;
    border-radius: var(--radius-sm);
    background: var(--panel);
    border: 1px solid var(--vi-line);
    font-size: 14.2px;
    color: var(--dim);
    line-height: 1.8;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .guest-foot p { margin: 0; }

  .write-cta {
    margin-top: 26px;
    padding: 20px 24px;
    border-radius: var(--radius);
    background: linear-gradient(180deg, rgba(167, 139, 250, 0.09), var(--panel) 60%);
    border: 1px solid var(--vi-line-2);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    flex-wrap: wrap;
  }
  .write-cta strong { display: block; font-size: 16.5px; margin-bottom: 3px; color: var(--ink); }
  .write-cta p { margin: 0; font-size: 14.4px; color: var(--ink-2); }

  /* 跳转投稿指南 —— 与主导航按钮同一套视觉语言 */
  .write-btn {
    font-weight: 700;
    font-size: 14px;
    white-space: nowrap;
    border: 1px solid var(--vi-line);
    border-radius: 999px;
    padding: 9px 18px;
    background: rgba(21, 16, 44, 0.6);
    color: var(--ink-2);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: border-color 0.18s, color 0.18s;
    will-change: transform;
  }
  .write-btn:hover {
    text-decoration: none;
    border-color: var(--vi);
    color: var(--ink);
  }

  @media (max-width: 640px) {
    .write-cta { flex-direction: column; align-items: flex-start; }
    .write-btn { width: 100%; text-align: center; }
  }
</style>
