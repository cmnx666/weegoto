---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { SECTIONS, CONTRIBUTE, type SectionKey } from '../consts';

interface Props {
  entry: CollectionEntry<SectionKey>;
  section: SectionKey;
}

const { entry, section } = Astro.props;
const { Content } = await render(entry);
const meta = SECTIONS[section];
const fmt = (d: Date) =>
  `${d.getFullYear()} 年 ${d.getMonth() + 1} 月 ${d.getDate()} 日`;

const isGuest = entry.data.source === 'guest';
const author = entry.data.author;
const issue = entry.data.issue;
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article>
    <div class="crumb">
      <a href="/">首页</a> / <a href={`/${section}`}>{meta.label}</a>
    </div>

    <header class="article-head">
      <h1>{entry.data.title}</h1>
      <div class="meta">
        <span>{fmt(entry.data.date)}</span>
        {isGuest && <span class="guest-badge">访客投稿</span>}
        {author && <span class="byline">✍️ {author}</span>}
        {entry.data.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
    </header>

    <div class="prose">
      <Content />
    </div>

    {isGuest && (
      <aside class="guest-foot">
        <p>
          本文由访客投稿，内容代表作者个人观点，不一定代表项目组立场。
          如果你发现事实性问题，欢迎在
          <a href={issue ? `${CONTRIBUTE.issuesUrl}/${issue}` : CONTRIBUTE.issuesUrl} target="_blank" rel="noopener">
            原始投稿讨论
          </a>
          中指出。
        </p>
      </aside>
    )}

    {section === 'notes' && (
      <aside class="write-cta">
        <div>
          <strong>也想写一篇？</strong>
          <p>「心得分享」栏目向所有访客开放，不限于项目组成员。</p>
        </div>
        <a class="write-btn" href={CONTRIBUTE.guideUrl}>看看怎么投稿 →</a>
      </aside>
    )}
  </article>
</BaseLayout>

<style>
  .guest-badge {
    font-size: 12px;
    font-weight: 800;
    color: var(--brand);
    background: var(--brand-soft);
    border: 1px solid color-mix(in srgb, var(--brand) 30%, transparent);
    border-radius: 6px;
    padding: 1px 9px;
  }

  .byline {
    color: var(--ink-2);
    font-weight: 600;
  }

  .guest-foot {
    margin-top: 42px;
    padding: 16px 20px;
    border-radius: 11px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    font-size: 14.2px;
    color: var(--muted);
    line-height: 1.8;
  }
  .guest-foot p { margin: 0; }

  .write-cta {
    margin-top: 26px;
    padding: 20px 24px;
    border-radius: var(--radius);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--brand) 7%, var(--surface)),
      var(--surface)
    );
    border: 1px solid color-mix(in srgb, var(--brand) 26%, var(--line));
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    flex-wrap: wrap;
  }
  .write-cta strong { display: block; font-size: 16.5px; margin-bottom: 3px; }
  .write-cta p { margin: 0; font-size: 14.4px; color: var(--ink-2); }

  .write-btn {
    font-weight: 700;
    font-size: 14.6px;
    white-space: nowrap;
    border: 1px solid color-mix(in srgb, var(--brand) 40%, transparent);
    border-radius: 9px;
    padding: 9px 18px;
    background: var(--surface);
  }
  .write-btn:hover { text-decoration: none; background: var(--brand-soft); }
</style>
