---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在">
  <div class="section-head">
    <div class="en">404</div>
    <h1>这里没有内容</h1>
    <p>链接可能写错了，或者这篇文章还没写。</p>
  </div>
  <div class="cards">
    <a class="card" href="/" data-cursor="card" data-magnetic="0.16" data-tag="回家 →">
      <h3>回到首页</h3>
      <p>看看最新的项目进展。</p>
    </a>
  </div>
</BaseLayout>
